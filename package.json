{
  "name": "small-business-sales-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node test/coverage-gate.js && node server/test.js && node test-e2e.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:coverage": "node test/coverage-gate.js",
    "e2e": "node test-e2e.js",
    "secret-scan": "node scripts/secret-scan.js",
    "a11y": "node scripts/a11y-check.js",
    "budget": "node scripts/check-bundle-budget.js",
    "check": "node scripts/secret-scan.js && node scripts/a11y-check.js && npm run typecheck && npm run lint && npm run test && npm run build && npm run budget"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "axe-core": "4.14.1",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  }
}
