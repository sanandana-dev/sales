{
  "name": "small-business-sales-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server": "npm --prefix server start",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "npm --prefix server run seed",
    "build": "npm --prefix client run build",
    "typecheck": "tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node test/coverage-gate.js && node server/test.js && node test-e2e.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:coverage": "node test/coverage-gate.js",
    "secret-scan": "node scripts/secret-scan.js",
    "a11y": "node scripts/a11y-check.js",
    "check": "node scripts/secret-scan.js && node scripts/a11y-check.js && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.11",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "axe-core": "4.10.2",
    "concurrently": "8.2.2",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "25.0.1",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "zod": "3.23.8"
  }
}
